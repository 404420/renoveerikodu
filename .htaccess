Options -Indexes

# Compress text responses and cache versioned/static assets on Apache.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
# Kaitse vanu admini koopiaid, varukoopiaid ja arendusfaile.
RewriteEngine On
RewriteRule ^(?:adminvana|backup|private-google|scripts|tests|\.git|\.github)(?:/|$) - [F,END,NC]
RewriteCond %{REQUEST_URI} !^/api/uploads/contact/ [NC]
RewriteRule \.zip$ - [F,END,NC]
<FilesMatch "(?i)(^error_log$|^\.env|\.(sql|bak|old|log|md)$)">
  Require all denied
</FilesMatch>

DirectoryIndex index.html index.php

<FilesMatch "^(config|config\.example|database)\.(php|sql)$">
  Require all denied
</FilesMatch>

RewriteBase /

# Retired parquet case study now points to the service page.
RewriteRule ^parketi-paigaldus-tallinn-korter(?:\.html)?/?$ https://www.renoveerikodu.ee/parketipaigaldus [R=301,L,NE]

# Force homepage variants to the clean root URL.
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/+index\.(html|php)[\s?] [NC]
RewriteRule ^index\.(html|php)$ https://www.renoveerikodu.ee/ [R=301,L,NE]

# Force folder index files to the clean folder URL, e.g. /admin/index.php -> /admin/.
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/+(.+/)?index\.(html|php)[\s?] [NC]
RewriteRule ^(.+/)?index\.(html|php)$ https://www.renoveerikodu.ee/$1 [R=301,L,NE]

# Force public .html URLs to extensionless URLs, e.g. /kontakt.html -> /kontakt.
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^(.+)\.html$ https://www.renoveerikodu.ee/$1 [R=301,L,NE]

# Force public .php URLs to extensionless URLs on normal page visits.
# POST requests are not redirected, so forms and API endpoints keep working.
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteCond %{REQUEST_URI} !^/api/ [NC]
RewriteRule ^(.+)\.php$ https://www.renoveerikodu.ee/$1 [R=301,L,NE]

# Force clean page URLs without a trailing slash, e.g. /kontakt/ -> /kontakt.
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ https://www.renoveerikodu.ee/$1 [R=301,L,NE]

# Force every remaining public URL to the preferred HTTPS + WWW host in one hop.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.renoveerikodu\.ee$ [NC]
RewriteRule ^ https://www.renoveerikodu.ee%{REQUEST_URI} [R=301,L,NE]

# Keep the worker panel on its PHP implementation after canonical redirects.
RewriteRule ^paneel(?:\.html|\.php)?/?$ paneel.php [END]

# Serve existing files and folders directly after canonical redirects.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Internally serve clean URLs from matching .html files.
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Internally serve clean URLs from matching .php files.
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# Fall back to the static homepage. Do not route unknown URLs to WordPress/PHP.
RewriteRule ^$ index.html [L]
