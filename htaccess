DirectoryIndex index.html

<FilesMatch "^(config|config\.example|database)\.(php|sql)$">
  Require all denied
</FilesMatch>

RewriteEngine On
RewriteBase /

# Force the canonical www host so Search Console signals do not split.
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{HTTP_HOST} ^renoveerikodu\.ee$ [NC]
RewriteRule ^ https://www.renoveerikodu.ee%{REQUEST_URI} [R=301,L,NE]

# Serve existing files and folders directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Keep clean URLs working for static HTML pages, e.g. /kontakt -> /kontakt.html.
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/.]+)$ $1.html [L]

# Fall back to the static homepage. Do not route to WordPress/PHP.
RewriteRule ^$ index.html [L]
